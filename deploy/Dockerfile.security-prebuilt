# Retain the verified deployed runtime; package binaries/assets built off-host.
# RUNTIME_IMAGE must identify the recorded local rollback image, verified before build.
# Compile server off-host for Linux/ARM64 with CGO_ENABLED=0 from the deployed commit.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}
COPY --chown=10001:10001 server /app/server
USER root
RUN rm -rf /app/frontend/dist
COPY --chown=10001:10001 frontend-dist /app/frontend/dist
USER dashboard
ARG VERSION
LABEL org.opencontainers.image.revision=$VERSION
