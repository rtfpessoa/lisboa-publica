# Copy to .env, set mode 600, and replace these values before starting Compose.
VERSION=replace-with-a-commit-already-on-main
# Use a long URL-safe password; it is also embedded in the local connection URL.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_VOLUME_NAME=lisboa-publica_postgres_data
TRUSTED_PROXY_CIDRS=replace-with-the-existing-caddy-network-subnet
SNAPSHOT_RETENTION_DAYS=30
HISTORY_INTERVAL_SECONDS=300
STORAGE_GUARD=true
METRO_CLIENT_ID=
METRO_CLIENT_SECRET=
